{
  "name": "@gpjs-ui/vue",
  "version": "0.0.0-0",
  "private": true,
  "description": "Vue 3 custom renderer for gpjs-ui, mapping createRenderer's lifecycle methods to gpjs-ui core calls.",
  "keywords": [
    "custom-renderer",
    "desktop-app",
    "gpjs-ui",
    "gui",
    "vue",
    "vue3"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/gpjs-ui.git",
    "directory": "packages/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check"
  },
  "dependencies": {
    "gpjs-ui": "workspace:*"
  },
  "devDependencies": {
    "@vue/runtime-core": "^3.5.42",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "peerDependencies": {
    "@vue/runtime-core": "^3.5.42"
  }
}
