{
  "name": "@gpjs-ui/vue",
  "version": "0.0.0-0",
  "description": "Vue 3 custom renderer for gpjs-ui, mapping createRenderer's lifecycle methods to gpjs-ui core calls.",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/gpjs-ui.git",
    "directory": "packages/vue"
  },
  "license": "(MIT OR Apache-2.0)",
  "keywords": [
    "vue",
    "vue3",
    "custom-renderer",
    "gpjs-ui",
    "desktop-app",
    "gui"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vue/runtime-core": "^3.5.42",
    "gpjs-ui": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  }
}
