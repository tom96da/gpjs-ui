{
  "name": "@gpjs-ui/vite",
  "version": "0.0.0-0",
  "private": true,
  "description": "Vite bundler adapter for gpjs-ui: watches an app's entry point and emits one self-contained bundle gpjs-ui-host can evaluate.",
  "keywords": [
    "bundler",
    "desktop-app",
    "gpjs-ui",
    "gui",
    "quickjs",
    "vite",
    "vue"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/gpjs-ui.git",
    "directory": "packages/vite"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vue/runtime-core": "^3.5.42",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rolldown": "~1.2.4",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  }
}
