{
  "name": "gpjs-ui",
  "version": "0.0.0-0",
  "description": "Framework-agnostic JS core for gpjs-ui — a typed wrapper around the native host bridge, shared by every framework adapter.",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/gpjs-ui.git",
    "directory": "packages/gpjs-ui"
  },
  "license": "(MIT OR Apache-2.0)",
  "keywords": [
    "gpui",
    "quickjs",
    "desktop-app",
    "gui",
    "webview-free",
    "cross-platform",
    "framework-agnostic",
    "electron-alternative",
    "tauri-alternative"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  }
}
