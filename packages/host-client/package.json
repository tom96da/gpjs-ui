{
  "name": "@gpjs-ui/host-client",
  "version": "0.0.0-0",
  "private": true,
  "description": "Spawns gpjs-ui-host and speaks its newline-delimited JSON-RPC dev protocol — the only package that does.",
  "keywords": [
    "desktop-app",
    "dev-server",
    "gpjs-ui",
    "gpui",
    "gui",
    "json-rpc",
    "quickjs"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/gpjs-ui.git",
    "directory": "packages/host-client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  }
}
